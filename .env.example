# Variables de infraestructura pura (MySQL) - copiar a .env y completar.
# Nunca commitear el .env real (ya esta en .gitignore).
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

# Tamano del buffer pool de InnoDB. Es el unico parametro del tuning de MySQL
# que depende del tamano del droplet - el resto vive en
# mysql/conf.d/00-nexolu.cnf, igual para todos.
#
#   nexolu-core (1GB, tres bases de ~0.6MB en total): 64M
#   nexolu-pos-prod / nexolu-pos-sg (2GB, base de POS real): 256M
#
# Si se deja vacio o sin definir, queda en 128M (el default de MySQL).
MYSQL_BUFFER_POOL_SIZE=
